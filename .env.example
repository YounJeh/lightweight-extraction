# Choisir le modèle utilisé (vide = défaut LangExtract, actuellement
# gemini-3.5-flash — voir app/tools/ner_langextract.py). Format attendu :
# un model_id LangExtract brut (ex. "gemini-3.5-flash", "gpt-4o-mini"), pas
# un identifiant préfixé par un fournisseur (ex. "google/...", style OpenRouter).
# Un model_id "gpt-4*"/"gpt-5*" route vers OpenAI (clé OPENAI_API_KEY),
# tout le reste route vers Gemini (clé GOOGLE_GENERATIVE_AI_API_KEY).
LLM_MODEL=

# Clé google
GOOGLE_GENERATIVE_AI_API_KEY=

# Clé OpenAI (utilisée si LLM_MODEL commence par gpt-4/gpt-5)
OPENAI_API_KEY=

# Tracing Langfuse (optionnel — absent = pas de tracing, NoOpTracer utilisé).
# Clés d'un projet Langfuse Cloud (https://cloud.langfuse.com).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Vide = https://cloud.langfuse.com (région EU) par défaut du SDK.
# Région US : https://us.cloud.langfuse.com
LANGFUSE_BASE_URL=

# Basic Auth applicatif (protège l'app en déploiement public, ex. Cloud Run).
# Vide = pas d'authentification (comportement local par défaut).
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=